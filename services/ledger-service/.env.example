LEDGER_OUTBOX_DEAD_LETTER_TOPIC=dead-letter.events
LEDGER_OUTBOX_CLIENT_ID=ledger-outbox-publisher
LEDGER_OUTBOX_BATCH_SIZE=100
LEDGER_OUTBOX_MAX_ATTEMPTS=5
LEDGER_OUTBOX_RETRY_DELAY_MS=5000
LEDGER_OUTBOX_RUN_FOREVER=false
LEDGER_OUTBOX_POLL_INTERVAL_MS=1000
LEDGER_OUTBOX_REQUEUE_DEAD_LETTER=true
LEDGER_OUTBOX_DRAIN_MAX_CYCLES=10
LEDGER_RECONCILE_ACCOUNT_ID=
LEDGER_RECONCILE_ASSET_CODE=
LEDGER_RECONCILE_INCLUDE_MATCHED=false
LEDGER_RECONCILE_FAIL_ON_MISMATCH=true
LEDGER_REPLAY_ACCOUNT_ID=
LEDGER_REPLAY_ASSET_CODE=
LEDGER_REPLAY_FAIL_ON_MISMATCH=false
LEDGER_ALERT_STALE_LOCK_MINUTES=30
LEDGER_ALERT_MAX_PENDING_OUTBOX=100
LEDGER_ALERT_MAX_RETRYING_OUTBOX=20
LEDGER_ALERT_MAX_DEAD_LETTERED_OUTBOX=0
LEDGER_ALERT_MAX_OLDEST_PENDING_OUTBOX_AGE_SECONDS=300
LEDGER_ALERT_MAX_STALE_LOCKS=0
LEDGER_ALERT_MAX_BALANCE_MISMATCHES=0
LEDGER_ALERT_MAX_NEGATIVE_AVAILABLE_BALANCES=0
LEDGER_ALERT_MAX_NEGATIVE_LOCKED_BALANCES=0
LEDGER_WITHDRAWAL_SETTLEMENT_ACCOUNT_ID=00000000-0000-0000-0000-000000000098
LEDGER_OPENING_BALANCE_ACCOUNT_ID=00000000-0000-0000-0000-000000000090
# Scheduled reconciliation (balance + order-vs-lock) and the circuit breaker.
# 0 disables the schedule (manual runs still work); pnpm demo:up passes 30.
RECONCILIATION_INTERVAL_SECONDS=0
RECONCILIATION_INITIAL_DELAY_SECONDS=
RECONCILIATION_ORDER_LOCK_GRACE_SECONDS=15
RECONCILIATION_BREAKER_ENABLED=true
RECONCILIATION_BREAKER_CONFIRMATIONS=2
RECONCILIATION_HISTORY_LIMIT=2000
LEDGER_ORDER_SERVICE_URL=http://127.0.0.1:3009
LEDGER_RISK_SERVICE_URL=http://127.0.0.1:3008
