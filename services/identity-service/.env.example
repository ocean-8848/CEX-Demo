PORT=3005
DATABASE_URL=postgres://web3:web3@127.0.0.1:5432/web3_cex
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=web3
PGPASSWORD=web3
PGDATABASE=web3_cex
PGSSL=false
IDENTITY_REPOSITORY=postgres
TWO_FACTOR_ISSUER=Web3 CEX
TWO_FACTOR_TIME_STEP_SECONDS=30
TWO_FACTOR_DIGITS=6
TWO_FACTOR_WINDOW=1
OPS_SESSION_TTL_HOURS=12
CUSTOMER_SESSION_TTL_HOURS=168
OPS_REQUIRE_TWO_FACTOR=true
# failed-login lock: N wrong passwords / 2FA codes (since the last success, within the window) lock login; 0 disables
IDENTITY_LOGIN_MAX_FAILURES=5
IDENTITY_LOGIN_FAILURE_WINDOW_SECONDS=900
IDENTITY_LOGIN_LOCK_SECONDS=300
# new-device login inbox notification (written to wallet-service over internal HMAC)
IDENTITY_NEW_DEVICE_NOTIFY=true
IDENTITY_WALLET_SERVICE_BASE_URL=http://127.0.0.1:3002
