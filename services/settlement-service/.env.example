PORT=3010
DATABASE_URL=postgres://web3:web3@127.0.0.1:5432/web3_cex
LEDGER_SERVICE_BASE_URL=http://127.0.0.1:3001
SETTLEMENT_REPOSITORY=postgres
SETTLEMENT_RECOVERY_RUN_FOREVER=false
SETTLEMENT_RECOVERY_POLL_INTERVAL_MS=5000
SETTLEMENT_RECOVERY_BATCH_SIZE=20
SETTLEMENT_ORDER_SERVICE_BASE_URL=http://127.0.0.1:3009
SETTLEMENT_ORDER_EVENT_TRANSPORT=redis_stream
SETTLEMENT_EVENT_REDIS_URL=redis://127.0.0.1:6379
SETTLEMENT_EVENT_STREAM_PREFIX=web3-cex:trade-events
SETTLEMENT_EVENT_SUBSCRIBER=redis_stream
SETTLEMENT_EVENT_SUBSCRIBER_RUN_FOREVER=true
SETTLEMENT_EVENT_SUBSCRIBER_POLL_INTERVAL_MS=5000
SETTLEMENT_EVENT_SUBSCRIBER_BATCH_SIZE=50
SETTLEMENT_EVENT_SUBSCRIBER_OVERLAP_COUNT=50
SETTLEMENT_EVENT_CONSUMER_ID=settlement-default
SETTLEMENT_FAULT_LAB_ENABLED=true
SETTLEMENT_CONSUMER_PAUSE_DEFAULT_MS=120000
SETTLEMENT_CONSUMER_PAUSE_MAX_MS=600000
