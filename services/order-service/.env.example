PORT=3009
DATABASE_URL=postgres://web3:web3@127.0.0.1:5432/web3_cex
ORDER_SERVICE_REPOSITORY=postgres
RISK_SERVICE_BASE_URL=http://127.0.0.1:3008
LEDGER_SERVICE_BASE_URL=http://127.0.0.1:3001
SETTLEMENT_SERVICE_BASE_URL=http://127.0.0.1:3010
MATCHING_ENGINE_HOST=127.0.0.1
MATCHING_ENGINE_PORT=3011
ORDER_RECOVERY_POLL_INTERVAL_MS=5000
ORDER_RECOVERY_BATCH_SIZE=20
ORDER_RECOVERY_LEASE_RENEW_INTERVAL_MS=5000
ORDER_RECOVERY_WORKER_ID=
ORDER_RECOVERY_RUN_FOREVER=false
ORDER_TRADE_EVENT_PROTOCOL_MIN=v2
ORDER_TRADE_EVENT_PROTOCOL_MAX=v2
ORDER_TRADE_EVENT_PROTOCOLS=v2
ORDER_EVENT_PUBLISHER=redis_stream
ORDER_EVENT_CHANNEL=web3-cex:trading.events
ORDER_EVENT_REDIS_URL=redis://127.0.0.1:6379
ORDER_EVENT_STREAM_PREFIX=web3-cex:trade-events
ORDER_EVENT_STREAM_MAX_LEN=10000
ORDER_EVENT_STREAM_RETENTION_MS=3600000
ORDER_EVENT_STREAM_TRIM_COOLDOWN_MS=60000
ORDER_EVENT_STREAM_AUTO_TRIM=true
ORDER_EVENT_STREAM_PRESSURE_WARNING_RATIO=0.8
ORDER_EVENT_STREAM_LAG_WARNING_THRESHOLD=10
ORDER_EVENT_STREAM_LAG_CRITICAL_THRESHOLD=50
ORDER_EVENT_ARCHIVE_ENABLED=true
ORDER_EVENT_ARCHIVE_STREAM_PREFIX=web3-cex:trade-events:archive
ORDER_EVENT_ARCHIVE_STREAM_MAX_LEN=50000
ORDER_EVENT_STREAM_MAINTENANCE_RUN_FOREVER=true
ORDER_EVENT_STREAM_MAINTENANCE_INTERVAL_MS=60000
ORDER_FAULT_LAB_ENABLED=true
# VIP fee tiers (config/fee-tiers.json; override path with WEB3_CEX_FEE_TIERS_CONFIG)
ORDER_FEE_TIERS_ENABLED=true
ORDER_FEE_TIER_CACHE_MS=30000
