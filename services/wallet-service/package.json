{
  "name": "@web3-cex/wallet-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @web3-cex/domain --filter @web3-cex/telemetry build",
    "build": "tsc -p tsconfig.json",
    "db:prepare": "pnpm build && node ./dist/scripts/run-db-prepare.js",
    "deliver-notifications": "pnpm build && node ./dist/scripts/deliver-notifications.js",
    "reconcile-stale-withdrawals": "pnpm build && node ./dist/scripts/reconcile-stale-withdrawals.js",
    "start": "pnpm build && node --import @web3-cex/telemetry/register ./dist/main.js",
    "pretypecheck": "pnpm --filter @web3-cex/domain --filter @web3-cex/telemetry build",
    "test": "pnpm build && node --test dist/__tests__/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@web3-cex/domain": "workspace:*",
    "@web3-cex/telemetry": "workspace:*",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
