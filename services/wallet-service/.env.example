PORT=3002
DATABASE_URL=postgres://web3:web3@127.0.0.1:5432/web3_cex
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=web3
PGPASSWORD=web3
PGDATABASE=web3_cex
PGSSL=false
LEDGER_SERVICE_BASE_URL=http://127.0.0.1:3001
CUSTODY_ADAPTER_BASE_URL=http://127.0.0.1:3004
IDENTITY_SERVICE_BASE_URL=http://127.0.0.1:3005
LEDGER_DEPOSIT_SOURCE_ACCOUNT_ID=00000000-0000-0000-0000-000000000098
LEDGER_WITHDRAWAL_SETTLEMENT_ACCOUNT_ID=00000000-0000-0000-0000-000000000098
DEPOSIT_CONFIRMATION_THRESHOLD=12
WITHDRAWAL_CONFIRMATION_THRESHOLD=12
WITHDRAWAL_REQUIRE_2FA=false
WITHDRAWAL_REQUIRE_WHITELIST=false
WITHDRAWAL_MIN_AMOUNT_BY_ASSET=USDT=10
WITHDRAWAL_MIN_FEE_BY_NETWORK=ethereum=1
WITHDRAWAL_SINGLE_LIMIT_BY_ASSET=USDT=10000
WITHDRAWAL_DAILY_LIMIT_BY_ASSET=USDT=20000
# KYC tier limits (single/daily per asset); defaults live in src/domain/withdrawal-policy.ts
WITHDRAWAL_KYC_LIMITS_ENABLED=true
WITHDRAWAL_KYC_LIMITS_UNVERIFIED=USDT=1000/2000,ETH=0.5/1,BTC=0.02/0.05
WITHDRAWAL_KYC_LIMITS_L1=USDT=10000/20000,ETH=5/10,BTC=0.2/0.5
WITHDRAWAL_KYC_LIMITS_L2=USDT=100000/200000,ETH=50/100,BTC=2/5
# amounts strictly above the threshold need two different ops approvers
WITHDRAWAL_DUAL_APPROVAL_THRESHOLD_BY_ASSET=USDT=5000,USDC=5000,ETH=2,BTC=0.1,SOL=50
# lock withdrawals after a new address / 2FA change (code default 86400; the demo stack passes 0)
WITHDRAWAL_SECURITY_COOLDOWN_SECONDS=0
WALLET_NOTIFICATION_BATCH_SIZE=100
WALLET_NOTIFICATION_MAX_ATTEMPTS=5
WALLET_NOTIFICATION_RETRY_DELAY_MS=5000
WALLET_EVENT_PUBLISHER=redis
WALLET_REDIS_URL=redis://127.0.0.1:6379
WALLET_NOTIFICATION_EVENT_CHANNEL=web3-cex:wallet.notifications
WALLET_NOTIFICATION_RUN_FOREVER=false
WALLET_NOTIFICATION_POLL_INTERVAL_MS=1000
WALLET_STALE_WITHDRAWAL_MINUTES=30
WALLET_STALE_WITHDRAWAL_BATCH_SIZE=100
WALLET_STALE_REBROADCAST_AUTO_CONFIRM=false
WALLET_STALE_BROADCAST_CONFIRMATIONS=0
WALLET_STALE_BROADCAST_BLOCK_NUMBER=0
WALLET_STALE_WITHDRAWAL_OPERATOR_ID=system:stale-cleanup
# simplified KYT (withdrawal address risk); false = every withdrawal scores low, nothing is blocked
WITHDRAWAL_RISK_ENABLED=true
# first-time address + amount strictly above this adds FIRST_TIME_LARGE_AMOUNT (+40)
WITHDRAWAL_RISK_LARGE_AMOUNT_BY_ASSET=USDT=1000,USDC=1000,ETH=0.5,BTC=0.02,SOL=10
# address book entries younger than this add NEW_ADDRESS_COOLDOWN (+30)
WITHDRAWAL_RISK_NEW_ADDRESS_WINDOW_SECONDS=86400
# extra demo labels appended to the built-in set (address=mixer|high_risk|gambling|darknet)
WITHDRAWAL_RISK_ADDRESS_LABELS=
# optional: lock withdrawals N seconds after a login from a new device (0 = off)
WITHDRAWAL_NEW_DEVICE_LOCK_SECONDS=0
