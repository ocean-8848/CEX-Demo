PORT=3008
LEDGER_SERVICE_BASE_URL=http://127.0.0.1:3001
# Market rules + default reference prices come from config/markets.json.
# Optional per-market override: RISK_REFERENCE_PRICE_<BASE>_<QUOTE>
# RISK_REFERENCE_PRICE_SOL_USDT=150
# Market halt/resume overrides: postgres (default, table risk_market_status_overrides) or memory
RISK_MARKET_STATUS_STORE=postgres
RISK_MARKET_STATUS_CACHE_MS=1000
DATABASE_URL=postgres://web3:web3@127.0.0.1:5432/web3_cex
# Market surveillance (reads trades / cancelled orders from order-service)
ORDER_SERVICE_BASE_URL=http://127.0.0.1:3009
RISK_SURVEILLANCE_ENABLED=true
RISK_SURVEILLANCE_INTERVAL_MS=60000
RISK_SURVEILLANCE_LOOKBACK_MS=3600000
RISK_SURVEILLANCE_WASH_MIN_TRADES=1
RISK_SURVEILLANCE_WASH_WINDOW_MS=3600000
RISK_SURVEILLANCE_CONCENTRATION_RATIO=0.3
RISK_SURVEILLANCE_CONCENTRATION_WINDOW_MS=3600000
RISK_SURVEILLANCE_CONCENTRATION_MIN_VOLUME=1000
RISK_SURVEILLANCE_CONCENTRATION_MIN_TRADES=5
RISK_SURVEILLANCE_SPOOF_MIN_NOTIONAL=2000
RISK_SURVEILLANCE_SPOOF_MAX_LIFETIME_MS=30000
RISK_SURVEILLANCE_SPOOF_MIN_ORDERS=3
RISK_SURVEILLANCE_SPOOF_WINDOW_MS=600000
RISK_SURVEILLANCE_PRICE_MOVE_RATIO=0.03
RISK_SURVEILLANCE_PRICE_MOVE_WINDOW_MS=300000
RISK_SURVEILLANCE_INCLUDE_MARKET_MAKERS=false
# Emergency switches (table risk_control_switches) use the same store mode; cache in ms
RISK_CONTROL_SWITCH_CACHE_MS=1000
