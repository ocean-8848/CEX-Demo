{
  "name": "@web3-cex/trader-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build-client.mjs && tsc -p tsconfig.json && node ./scripts/copy-public.mjs",
    "start": "pnpm build && node --import @web3-cex/telemetry/register ./dist/main.js",
    "test": "pnpm build && node --test dist/__tests__/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "pnpm --filter @web3-cex/domain --filter @web3-cex/telemetry --filter @web3-cex/web-ui build",
    "pretypecheck": "pnpm --filter @web3-cex/domain --filter @web3-cex/telemetry --filter @web3-cex/web-ui build"
  },
  "dependencies": {
    "@web3-cex/domain": "workspace:*",
    "@web3-cex/telemetry": "workspace:*",
    "@web3-cex/web-ui": "workspace:*",
    "lightweight-charts": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "playwright-core": "^1.54.2",
    "ws": "^8.18.3"
  }
}
